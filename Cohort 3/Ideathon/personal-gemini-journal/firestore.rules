rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for enterprise-grade zero-trust tenant isolation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile & Tenant Subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Subcollection: Private Journals & Conversational Transcripts
      match /journals/{journalId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcollection: Extracted Action Items & Goals
      match /action_items/{actionItemId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcollection: Synthesized Weekly Insights & Thought Patterns
      match /insights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Saved Summaries & Metadata
      match /summaries/{summaryId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

